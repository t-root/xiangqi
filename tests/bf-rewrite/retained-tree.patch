+// Một đối tượng gắn với MỘT thế cờ gốc + bộ luật; đổi thế/luật thì tự xóa cây.
+class RetainedMateSearch {
+public:
+    explicit RetainedMateSearch(size_t capBytes);
+    ~RetainedMateSearch();
+    RetainedMateSearch(const RetainedMateSearch&) = delete;
+    RetainedMateSearch& operator=(const RetainedMateSearch&) = delete;
+    void reset();
+    // level = ngân sách mỗi bên (như redBudget == blackBudget của probeForcedMate).
+    ProbeResult probe(Board& board, Color color, int level, CsCode csRed, CsCode csBlack, MateSearchState& st);
+    size_t usedBytes() const;
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
