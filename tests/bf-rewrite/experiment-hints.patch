diff --git a/engine/bruteforce-src/src/search.h b/engine/bruteforce-src/src/search.h
index eb313f0..10f1219 100644
--- a/engine/bruteforce-src/src/search.h
+++ b/engine/bruteforce-src/src/search.h
@@ -50,6 +50,47 @@ struct ScoredMove : Move {
     i64 ord = 0;
 };
 
+// Bảng gợi ý nước KHÔNG khóa theo số nước còn lại. TT chính khóa theo (thế cờ, ngân sách Đỏ/Đen) nên
+// sang mức budget mới nó không trúng và nước tốt nhất của mức trước bị mất; bảng này chỉ nhớ "nước
+// tốt nhất lần gần nhất ở thế này" bất kể ngân sách, để mức sau thử nước đó đầu tiên. CHỈ ảnh hưởng
+// thứ tự nước (như killer/history), không bao giờ cắt nhánh nên không đổi kết quả tìm kiếm.
+// Khóa gồm cả bên đang là "bên công" của lượt dò (thắng / bị thắng), vì hai lượt dò đó cần hai nước
+// khác nhau cho cùng một thế cờ.
+class HintTable {
+public:
+    void enable(size_t slotsPow2) {
+        if (slots_.size() == slotsPow2) return;
+        slots_.assign(slotsPow2, 0);
+        mask_ = slotsPow2 - 1;
+    }
+    bool enabled() const { return !slots_.empty(); }
+    void clear() { std::fill(slots_.begin(), slots_.end(), 0ULL); }
+    // Trả mã nước + 1 (cùng quy ước bestCode), 0 nếu chưa có.
+    i32 lookup(i32 kh1, i32 kh2, bool attackerRed) const {
+        if (slots_.empty()) return 0;
+        const u64 slot = slots_[index(kh1, attackerRed)];
+        if (static_cast<u32>(slot >> 32) != verify(kh2, attackerRed)) return 0;
+        return static_cast<i32>(slot & 0xFFFFu);
+    }
+    void store(i32 kh1, i32 kh2, bool attackerRed, i32 code) {
+        if (slots_.empty() || code <= 0 || code > 0xFFFF) return;
+        slots_[index(kh1, attackerRed)] = (static_cast<u64>(verify(kh2, attackerRed)) << 32) | static_cast<u64>(code);
+    }
+private:
+    using u64 = uint64_t;
+    size_t index(i32 kh1, bool attackerRed) const {
+        u32 v = static_cast<u32>(kh1) ^ (attackerRed ? 0x9E3779B1u : 0x85EBCA77u);
+        v ^= v >> 15; v *= 0x2545F491u; v ^= v >> 13;
+        return static_cast<size_t>(v) & mask_;
+    }
+    static u32 verify(i32 kh2, bool attackerRed) {
+        u32 v = static_cast<u32>(kh2) ^ (attackerRed ? 0xC2B2AE3Du : 0x27D4EB2Fu);
+        return v == 0 ? 1u : v;  // 0 dành cho ô trống
+    }
+    std::vector<u64> slots_;
+    size_t mask_ = 0;
+};
+
